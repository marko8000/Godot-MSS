; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SG2Core"
run/main_scene="res://exec/sg2_start_exec/sg2_start_exec.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://levels/SG2Core/x_res/x_images/vin17_x_godot.png"
config/icon="uid://cwymkxeduqt3u"

[autoload]

File2ool="*res://globals/File2ool/file2ool.gd"
ExecManager="*res://globals/ExecManager/exec_manager.gd"
Debug="*res://globals/Debug/debug.gd"
ZipArchiver="*res://globals/File2ool/ZipArchiver/zip_archiver.gd"
R="*res://globals/ExecManager/randomizer.gd"
Dispenser="*res://globals/Dispenser/dispenser.gd"
G="*res://globals/GetAPI/get_api.gd"

[debug]

gdscript/warnings/unassigned_variable_op_assign=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0

[file_customization]

folder_colors={
"res://exec/": "orange",
"res://globals/": "red",
"res://levels/": "orange",
"res://levels/SG2Core/x_res/": "yellow",
"res://levels/SG2Core/x_res/x_fonts/": "yellow",
"res://levels/SG2Core/x_res/x_images/": "yellow"
}

